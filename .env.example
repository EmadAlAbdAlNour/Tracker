# Example environment variables (do NOT store real secrets here)
DATABASE_URL=postgres://user:password@localhost:5432/tracker_dev
JWT_SECRET=replace-with-secure-random
JWT_REFRESH_SECRET=replace-with-secure-random
MAPBOX_TOKEN=your-mapbox-token
API_URL=http://localhost:3000
SOCKET_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Comma-separated list of allowed browser origins for CORS. Leave empty to deny browser access by default.
# Example: CORS_ALLOWED_ORIGINS=https://tracker.example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Optional
PORT=3000

# Notes:
# - Replace placeholders with real values in your local .env (do not commit .env)
# - For Android emulator, use http://10.0.2.2:3000
# - For a physical Android phone, use http://<developer-machine-ip>:3000
# - For production, use environment-specific secrets management
